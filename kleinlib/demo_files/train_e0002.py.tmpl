"""E0002 -- all 30 features, a standardized logistic regression.

One falsifiable idea per candidate: change the block between the CANDIDATE
markers, run `klein run-one`, reflect in program.md. The partition always comes
from the contract (`load_partition`), never from a seed in this file.
"""

from __future__ import annotations

import os
import time
import warnings

from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import PolynomialFeatures, StandardScaler

from kleinlib.contract import load_contract
from kleinlib.data import load_partition
from kleinlib.eval import evaluate

warnings.filterwarnings("ignore")

SMOKE = os.environ.get("KLEIN_SMOKE") == "1"
EXPERIMENT_ID = os.environ.get("KLEIN_EXPERIMENT_ID") or ("SMOKE" if SMOKE else None)

# --- CANDIDATE -------------------------------------------------------------
FEATURES = None               # None = every feature the table has
PAIRWISE = False
REFERENCE_ALL_FEATURES = False
# --- END CANDIDATE ---------------------------------------------------------


def logistic(pairwise: bool = False):
    steps = [StandardScaler()]
    if pairwise:
        steps += [PolynomialFeatures(2, include_bias=False), StandardScaler()]
    return make_pipeline(*steps, LogisticRegression(max_iter=5000))


def main() -> None:
    if EXPERIMENT_ID is None:
        raise SystemExit("run through `klein run-one` (or KLEIN_SMOKE=1 for a shape check)")
    t0 = time.time()
    X_fit, X_eval, y_fit, y_eval = load_partition(target="target")
    columns = FEATURES or list(X_fit.columns)
    model = logistic(PAIRWISE)
    fit_start = time.time()
    model.fit(X_fit[columns], y_fit)
    fit_seconds = time.time() - fit_start

    extra: dict[str, str] = {}
    minimum_delta = float(
        load_contract(".")["tracks"]["primary"]["metric"].get("minimum_delta") or 0.0
    )
    if REFERENCE_ALL_FEATURES:
        # The reference rung is refitted on the SAME rows inside this run, so the
        # paired difference below is not a comparison across two different draws.
        reference = logistic().fit(X_fit, y_fit)
        reference_auc = float(roc_auc_score(y_eval, reference.predict_proba(X_eval)[:, 1]))
        candidate_auc = float(roc_auc_score(y_eval, model.predict_proba(X_eval[columns])[:, 1]))
        extra["reference_auc"] = f"{reference_auc:.6f}"
        extra["delta_vs_reference"] = f"{candidate_auc - reference_auc:.6f}"
        if minimum_delta > 0:
            extra["delta_in_floors"] = f"{(candidate_auc - reference_auc) / minimum_delta:.4f}"

    evaluate(
        model,
        X_eval[columns],
        y_eval,
        exp_id=EXPERIMENT_ID,
        t0=t0,
        fit_seconds=fit_seconds,
        train_n=len(X_fit),
        val_n=len(X_eval),
        metric_name="val_auc",
        metric_goal="higher",
        extra=extra or None,
        study_dir=".",
    )


if __name__ == "__main__":
    main()
