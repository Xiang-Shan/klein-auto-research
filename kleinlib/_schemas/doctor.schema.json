{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xiang-Shan/klein-auto-research/schemas/v1/doctor.schema.json",
  "title": "klein doctor",
  "description": "What this machine can run. Unlike the check lists, rows carry no `level` and there is no `summary`; the verb exits 0 (envelope `ok: true`) even when `data.ok` is false, unless `--strict`. A refused verb returns an empty `data` object (the reason is in the envelope's `problems`); when `data` is not empty it carries the required keys.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "Every check passed."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "if": {
    "minProperties": 1
  },
  "then": {
    "required": [
      "ok",
      "checks"
    ]
  }
}
