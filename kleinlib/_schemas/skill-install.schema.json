{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xiang-Shan/klein-auto-research/schemas/v1/skill-install.schema.json",
  "title": "klein skill install",
  "description": "What `klein skill install` wrote. A refused verb returns an empty `data` object (the reason is in the envelope's `problems`); when `data` is not empty it carries the required keys.",
  "type": "object",
  "properties": {
    "target": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "files": {
      "type": "integer"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Worker agent file names installed."
    }
  },
  "additionalProperties": true,
  "if": {
    "minProperties": 1
  },
  "then": {
    "required": [
      "target",
      "skill",
      "files",
      "agents"
    ]
  }
}
