{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xiang-Shan/klein-auto-research/schemas/v1/new.schema.json",
  "title": "klein new",
  "description": "A scaffolded study. A refused verb returns an empty `data` object (the reason is in the envelope's `problems`); when `data` is not empty it carries the required keys.",
  "type": "object",
  "properties": {
    "study": {
      "type": "string",
      "description": "The study directory."
    },
    "branch": {
      "type": "string",
      "description": "The branch to switch to: `experiments/<slug>`."
    }
  },
  "additionalProperties": true,
  "if": {
    "minProperties": 1
  },
  "then": {
    "required": [
      "study",
      "branch"
    ]
  }
}
