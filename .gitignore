# Raw & prepared data — studies fetch/build these via prepare.py; never commit datasets
data/
**/data/prepared/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Run artifacts
run.log
.klein.lock
catboost_info/
optuna_studies/*.db

# Per-row holdout prediction tables (kleinlib.eval.save_holdout_predictions) —
