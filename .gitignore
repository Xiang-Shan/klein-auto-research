predictions/

# Unsafe/large model payloads — manifests are tracked; executable blobs are local
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.onnx

# macOS
.DS_Store

# Claude Code agent worktrees (never track)
.claude/worktrees/
*.npz
